{
  "manifest_version": 3,
  "name": "DeepWiki Redirect",
  "version": "1.0",
  "description": "Click the icon to redirect current GitHub page to DeepWiki",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://deepwiki.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Convert to DeepWiki"
  },
  "content_scripts": [{
    "matches": [
      "https://github.com/*",
      "https://deepwiki.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_end"
  }]
}
